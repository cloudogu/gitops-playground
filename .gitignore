.idea/*

# Allow the codeStyles directory
!.idea/codeStyles/

# If you want to allow ONLY those two specific files and ignore everything else inside codeStyles, use this:
.idea/codeStyles/*
!.idea/codeStyles/Project.xml
!.idea/codeStyles/codeStylesconfig.xml

.run
*.iml
target

# ignore evertything under scripts/local except shellscripts
scripts/local/**
!scripts/local/**/
!scripts/local/**/*.sh

scripts/dev/gop_airgapped_config.yaml

# do not check in the workspace
workspace/

# do not check in sensitive terraform files
*.tfstate
*.tfstate.*
terraform/plan
terraform/account.json
*.lock.hcl
**/.terraform/*
/.mvn/wrapper/maven-wrapper.jar
# Is created on "helm dep update ." but not needed in repo
/argocd/cluster-resources/apps/argocd/argocd/charts/

gitops-playground.jar
jenkins-plugins
/charts/
