.idea
.run
.codex
*.iml
target

# ignore evertything under scripts/local except shellscripts
scripts/local/**
!scripts/local/**/
!scripts/local/**/*.sh

scripts/dev/airgapped/gop_airgapped_config.yaml
scripts/dev/network-policies/netpol-local.yaml
# Keep the former local NetworkPolicy override path ignored during the directory migration.
scripts/dev/netpol-local.yaml

# do not check in the workspace
workspace/

# do not check in sensitive terraform files
*.tfstate
*.tfstate.*
terraform/plan
terraform/account.json
*.lock.hcl
**/.terraform/*
/.mvn/wrapper/maven-wrapper.jar
# Is created on "helm dep update ." but not needed in repo
/argocd/cluster-resources/apps/argocd/argocd/charts/

gitops-playground.jar
jenkins-plugins
/charts/
